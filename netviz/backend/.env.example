# NetViz 后端配置示例
# 复制此文件为 .env 并填入你的配置

# ==================== 应用配置 ====================
APP_NAME=NetViz
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ==================== 服务器配置 ====================
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite+aiosqlite:///./data/netviz.db

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=524288000

# ==================== AI 提供商配置 ====================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama (本地)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 默认 AI 提供商 (openai/anthropic/ollama/deepseek/none)
DEFAULT_AI_PROVIDER=none

# ==================== 威胁情报配置 ====================
# VirusTotal (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=

# ==================== 日志配置 ====================
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==================== 安全配置 ====================
SECRET_KEY=change-this-in-production
SETTINGS_ENCRYPTION_KEY=
ALLOW_UNSAFE_AI_BASE_URLS=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== CORS 配置 ====================
# 推荐使用 JSON 数组，后端也兼容逗号分隔字符串
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
